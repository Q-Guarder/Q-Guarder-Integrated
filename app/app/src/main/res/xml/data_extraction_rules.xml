<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 백업 / 기기 이전 규칙 -->
<data-extraction-rules>
    <cloud-backup>
        <!-- 인증 토큰 / DB 클라우드 백업 제외 -->
        <exclude domain="sharedpref" path="qrguard_secure_prefs.xml" />
        <exclude domain="database"   path="qguarder.db" />
    </cloud-backup>
    <device-transfer>
        <!-- 기기 이전(D2D) 시도 DB는 허용, 토큰은 제외 -->
        <exclude domain="sharedpref" path="qrguard_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
