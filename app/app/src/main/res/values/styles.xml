<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════
         TEXT APPEARANCES
         ══════════════════════════════════════════════ -->

    <!-- Display: Splash title -->
    <style name="TextAppearance.QGuard.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Headline Large: Result titles (26sp) -->
    <style name="TextAppearance.QGuard.HeadlineLarge" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Headline Medium: Section titles (22sp) -->
    <style name="TextAppearance.QGuard.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Headline Small: Page titles (20sp) -->
    <style name="TextAppearance.QGuard.HeadlineSmall" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Title Large (18sp) -->
    <style name="TextAppearance.QGuard.TitleLarge" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Title Medium: Button text, nav items (16sp) -->
    <style name="TextAppearance.QGuard.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Title Small (15sp) -->
    <style name="TextAppearance.QGuard.TitleSmall" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body Large (15sp) -->
    <style name="TextAppearance.QGuard.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Body Medium (14sp) -->
    <style name="TextAppearance.QGuard.BodyMedium" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Body Small: Card content, descriptions (13sp) -->
    <style name="TextAppearance.QGuard.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Label Large (12sp) -->
    <style name="TextAppearance.QGuard.LabelLarge" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Label Medium: Tab labels (11sp) -->
    <style name="TextAppearance.QGuard.LabelMedium" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Label Small: Card section headers (10sp) -->
    <style name="TextAppearance.QGuard.LabelSmall" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Caption: Timestamps, footnotes (11sp) -->
    <style name="TextAppearance.QGuard.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ══════════════════════════════════════════════
         BUTTON STYLES
         ══════════════════════════════════════════════ -->

    <style name="Widget.QGuard.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <style name="Widget.QGuard.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/color_threat</item>
        <item name="android:textColor">@color/color_on_threat</item>
    </style>

    <style name="Widget.QGuard.Button.Warning" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/color_warning</item>
        <item name="android:textColor">@color/color_on_warning</item>
    </style>

    <style name="Widget.QGuard.Button.Dark" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/color_text_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.QGuard.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.QGuard.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
    </style>

    <!-- ══════════════════════════════════════════════
         CARD STYLES
         ══════════════════════════════════════════════ -->

    <style name="Widget.QGuard.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/card_elevation_none</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="strokeColor">@color/color_outline</item>
    </style>

    <style name="Widget.QGuard.Card.Filled" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/card_elevation_none</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.QGuard.Card.Elevated" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation_lg</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ══════════════════════════════════════════════
         INPUT STYLES
         ══════════════════════════════════════════════ -->

    <style name="Widget.QGuard.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
    </style>

</resources>
