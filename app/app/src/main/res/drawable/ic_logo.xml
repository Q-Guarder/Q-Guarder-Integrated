    <!-- 방패 메인 바디 -->
    <path
        android:fillColor="#2543CC"
        android:pathData="M50,17 C30,17 16,26 16,40 L16,59 C16,76 32,87 50,91 C68,87 84,76 84,59 L84,40 C84,26 70,17 50,17 Z"/>

