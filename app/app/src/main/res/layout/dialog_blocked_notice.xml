<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위험 URL 차단"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:layout_marginBottom="8dp" />

        <!-- 고지 메시지 (서버 description 동적 주입) -->
        <TextView
            android:id="@+id/tv_notice_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이 URL은 피싱 사이트로 확인되어 차단되었습니다. 절대 접속하지 마세요."
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- 위험 요약 박스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF5F5"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 계좌·카드 정보 유출"
                android:textSize="13sp"
                android:textColor="#E53935"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 개인 인증정보 탈취"
                android:textSize="13sp"
                android:textColor="#E53935"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 기기 제어권 침해"
                android:textSize="13sp"
                android:textColor="#E53935" />

        </LinearLayout>

        <!-- 닫기 버튼: 5초 카운트다운 후 활성화 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notice_close"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="5초 후 닫기"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#E53935"
            app:cornerRadius="12dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- X 닫기 버튼 (오른쪽 상단) — 5초 후 작동 -->
    <TextView
        android:id="@+id/btn_notice_x"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:text="✕"
        android:textSize="11sp"
        android:textColor="#99000000"
        android:gravity="center"
        android:background="@drawable/bg_dialog_close"
        android:alpha="0.35"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
