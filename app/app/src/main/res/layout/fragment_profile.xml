<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- 페이지 타이틀 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 정보"
            android:textAppearance="@style/TextAppearance.QGuard.HeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="@dimen/space_base"
            android:layout_marginBottom="@dimen/space_lg" />

        <!-- 프로필 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/card_elevation_none"
            app:strokeWidth="@dimen/card_stroke_width"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 아바타 -->
                    <TextView
                        android:id="@+id/tv_avatar"
                        android:layout_width="@dimen/avatar_size"
                        android:layout_height="@dimen/avatar_size"
                        android:text="Q"
                        android:textAppearance="@style/TextAppearance.QGuard.HeadlineSmall"
                        android:textColor="?attr/colorPrimary"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:layout_marginEnd="@dimen/space_base" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="닉네임"
                            android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="email@example.com"
                            android:textAppearance="@style/TextAppearance.QGuard.LabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="@dimen/space_xxs" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 보안 활동 요약 카드 ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/card_elevation_none"
            app:cardBackgroundColor="@color/color_primary_container"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY SUMMARY"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
                    android:textColor="@color/color_on_primary_container"
                    android:layout_marginBottom="@dimen/space_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_total_scans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.QGuard.HeadlineMedium"
                            android:textColor="@color/color_on_primary_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="총 스캔"
                            android:textAppearance="@style/TextAppearance.QGuard.Caption"
                            android:textColor="@color/color_on_primary_container"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_total_blocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.QGuard.HeadlineMedium"
                            android:textColor="@color/color_threat" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="차단"
                            android:textAppearance="@style/TextAppearance.QGuard.Caption"
                            android:textColor="@color/color_on_primary_container"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_total_safe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.QGuard.HeadlineMedium"
                            android:textColor="@color/color_safe" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="안전"
                            android:textAppearance="@style/TextAppearance.QGuard.Caption"
                            android:textColor="@color/color_on_primary_container"
                            android:alpha="0.7" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 설정 메뉴 섹션 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/card_elevation_none"
            app:strokeWidth="@dimen/card_stroke_width"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 닉네임 변경 -->
                <LinearLayout
                    android:id="@+id/menu_edit_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="닉네임 변경"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="닉네임 변경"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="이동"
                        app:tint="@color/color_text_tertiary"
                        android:rotation="180" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="56dp" />

                <!-- 비밀번호 변경 -->
                <LinearLayout
                    android:id="@+id/menu_change_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_lock"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="비밀번호 변경"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="비밀번호 변경"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="이동"
                        app:tint="@color/color_text_tertiary"
                        android:rotation="180" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="56dp" />

                <!-- 히스토리 보관 기간 -->
                <LinearLayout
                    android:id="@+id/menu_history_retention"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_activity"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="히스토리 보관 기간"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="히스토리 보관 기간"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tv_history_retention_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전체"
                        android:textAppearance="@style/TextAppearance.QGuard.Caption"
                        android:textColor="@color/color_text_tertiary"
                        android:layout_marginEnd="@dimen/space_xs" />

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="이동"
                        app:tint="@color/color_text_tertiary"
                        android:rotation="180" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="56dp" />

                <!-- 다크모드 -->
                <LinearLayout
                    android:id="@+id/menu_dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_moon"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="다크모드"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="다크모드"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_dark_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 계정 섹션 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/card_elevation_none"
            app:strokeWidth="@dimen/card_stroke_width"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 회원 탈퇴 -->
                <LinearLayout
                    android:id="@+id/menu_delete_account"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/color_threat"
                        android:contentDescription="회원 탈퇴"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="회원 탈퇴"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="@color/color_threat" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 정보 섹션 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFORMATION"
            android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_md" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/card_elevation_none"
            app:strokeWidth="@dimen/card_stroke_width"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 앱 정보 -->
                <LinearLayout
                    android:id="@+id/menu_app_info"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_shield"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="앱 정보"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="앱 정보"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textAppearance="@style/TextAppearance.QGuard.Caption"
                        android:textColor="@color/color_text_tertiary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="56dp" />

                <!-- 이용약관 -->
                <LinearLayout
                    android:id="@+id/menu_terms"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_shield"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="이용약관"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="이용약관"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="이동"
                        app:tint="@color/color_text_tertiary"
                        android:rotation="180" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider"
                    android:layout_marginStart="56dp" />

                <!-- 개인정보 처리방침 -->
                <LinearLayout
                    android:id="@+id/menu_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_shield"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="개인정보 처리방침"
                        android:layout_marginEnd="@dimen/space_base" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="개인정보 처리방침"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="이동"
                        app:tint="@color/color_text_tertiary"
                        android:rotation="180" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 로그아웃 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.QGuard.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_md"
            android:text="로그아웃"
            android:textColor="@color/color_threat"
            app:strokeColor="@color/color_threat"
            app:cornerRadius="@dimen/radius_md"
            android:layout_marginTop="@dimen/space_2xl" />

        <!-- 앱 버전 footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q-Guard v1.0.0"
            android:textAppearance="@style/TextAppearance.QGuard.Caption"
            android:textColor="@color/color_text_disabled"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_2xl" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>