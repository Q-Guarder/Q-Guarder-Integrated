<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/terms_title"
            app:titleTextAppearance="@style/TextAppearance.QGuard.TitleMedium"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_3xl">

            <!-- 헤더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_base">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/terms_title"
                    android:textAppearance="@style/TextAppearance.QGuard.HeadlineMedium"
                    android:textColor="@color/color_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_version"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelLarge"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_badge_primary"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_effective_date"
                android:textAppearance="@style/TextAppearance.QGuard.BodySmall"
                android:textColor="@color/color_text_tertiary"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제1조 (목적) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제1조 (목적)"
                android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                android:textColor="@color/color_primary"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 약관은 Q-Guarder(이하 &#39;회사&#39;라고 합니다)가 제공하는 QR코드 기반 큐싱(피싱) 탐지 제반 서비스(이하 &#39;서비스&#39;)의 이용과 관련하여 회사와 회원과의 권리, 의무 및 책임사항, 기타 필요한 사항을 규정함을 목적으로 합니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제2조 (정의) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제2조 (정의)"
                android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                android:textColor="@color/color_primary"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 약관에서 사용하는 주요 용어의 정의는 다음과 같습니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.QGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. &#39;서비스&#39;라 함은 구현되는 단말기(스마트폰, 태블릿 등의 모바일 장치를 포함)와 상관없이 &#39;회원&#39;이 이용할 수 있는 회사가 제공하는 제반 서비스를 의미합니다.\n\n2. &#39;회원&#39;이란 이 약관에 따라 회사에 개인정보를 제공하여 회원등록을 한 사람으로, 회사가 제공하는 서비스를 계속적으로 이용할 수 있는 자를 말합니다.\n\n3. &#39;이메일&#39;이라 함은 회원의 식별과 서비스 이용을 위하여 회원이 등록한 전자우편 주소를 의미합니다.\n\n4. &#39;비밀번호&#39;라 함은 회원의 이메일과 일치되는 회원임을 확인하고 비밀의 보호를 위해 회원 자신이 정한 문자(특수문자 포함)와 숫자의 조합을 의미합니다.\n\n5. &#39;스캔&#39;이라 함은 회원이 QR 코드를 촬영하여 해당 URL의 악성 여부를 분석하는 회사의 핵심 서비스를 의미합니다.\n\n6. &#39;QR코드&#39;라 함은 정보를 저장할 수 있는 2차원 매트릭스 바코드를 말합니다.\n\n7. &#39;큐싱(Qshing)&#39;이라 함은 QR코드를 이용한 피싱 공격을 말합니다.\n\n8. &#39;ML 모델&#39;이라 함은 회사가 큐싱 탐지를 위해 운용하는 머신러닝 기반 보안 분석 모델을 말합니다."
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="@color/color_text_secondary"
                        android:lineSpacingMultiplier="1.6" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제3조 (약관 외 준칙) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제3조 (약관 외 준칙)"
                    android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_badge_revised"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
                    android:textColor="@color/color_warning"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs"
                    android:layout_marginStart="@dimen/space_sm" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 약관에서 정하지 아니한 사항에 대해서는 전기통신사업법, 정보통신망 이용촉진 및 정보보호 등에 관한 법률, 개인정보보호법 등 관계 법령 또는 회사가 정한 서비스의 개별약관, 운영정책 및 규칙 등(이하 &#39;세부지침&#39;)의 규정에 따릅니다. 본 약관과 세부지침이 충돌하는 경우에는 본 약관이 우선합니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제4조 (약관의 효력과 변경) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제4조 (약관의 효력과 변경)"
                    android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_badge_revised"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
                    android:textColor="@color/color_warning"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs"
                    android:layout_marginStart="@dimen/space_sm" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 이 약관은 Q-Guarder가 제공하는 서비스 내에 게시하여 공시합니다. 회사는 &#39;약관의 규제에 관한 법률&#39;, &#39;정보통신망 이용촉진 및 정보보호 등에 관한 법률&#39; 등 관계 법령에 위배되지 않는 범위 내에서 이 약관을 변경할 수 있으며, 변경 시 그 시행일로부터 최소 7일(이용자에게 불리하거나 중대한 사항의 변경은 30일) 이전부터 공지합니다. 기존 회원에게는 변경된 약관, 적용일자 및 변경사유를 전자우편, 서비스 내 알림 등의 방법으로 개별 통지합니다.\n\n2. 회사가 제1항에 따라 개정약관을 공지 또는 통지하는 경우 &#39;변경에 동의하지 아니한 경우 공지일 또는 통지를 받은 날로부터 7일(이용자에게 불리하거나 중대한 사항의 변경인 경우에는 30일) 내에 계약을 해지할 수 있으며, 계약해지의 의사표시를 하지 아니한 경우에는 변경에 동의한 것으로 본다.&#39;라는 취지의 내용을 함께 통지합니다.\n\n3. 회원이 제2항의 공지일 또는 통지를 받은 날로부터 해당 기간 내에 변경된 약관에 대해 거절의 의사를 표시하지 않았을 때에는 본 약관의 변경에 동의한 것으로 간주합니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제5조 (이용자에 대한 통지) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제5조 (이용자에 대한 통지)"
                android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                android:textColor="@color/color_primary"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 회사는 이 약관에 별도 규정이 없는 한 회원에게 전자우편, 서비스 내 알림 등의 전자적 수단을 이용하여 통지할 수 있습니다.\n\n2. 회사는 회원 전체에 대한 통지의 경우 7일 이상 회사가 운영하는 어플리케이션 내 공지사항에 게시함으로써 제1항의 통지에 갈음할 수 있습니다.\n\n3. 회사는 회원의 연락처 미기재, 변경 후 미수정, 오기재 등으로 인하여 개별 통지가 어려운 경우에 한하여 전항의 공지를 함으로써 개별 통지를 한 것으로 간주합니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제6조 (이용계약의 체결) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제6조 (이용계약의 체결)"
                android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                android:textColor="@color/color_primary"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이용계약은 회원이 되고자 하는 자가 약관의 내용에 대하여 동의를 한 다음 회원가입신청을 하고, 회사가 이러한 신청에 대하여 승낙한 때 체결됩니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제7조 (회원가입에 대한 승낙) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제7조 (회원가입에 대한 승낙)"
                    android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_badge_revised"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
                    android:textColor="@color/color_warning"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs"
                    android:layout_marginStart="@dimen/space_sm" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 회사는 이용계약에 대한 요청이 있을 때 서비스 이용을 승낙함을 원칙으로 합니다.\n\n2. 회사는 서비스 관련 설비의 여유가 없거나, 기술상 또는 업무상 문제가 있는 경우에는 승낙을 유보할 수 있습니다.\n\n3. 회사는 다음 각 호에 해당하는 경우 가입 신청을 승낙하지 않거나 사후에 이용계약을 해지할 수 있습니다.\n    가. 가입 신청자가 이전에 회원 자격을 상실한 적이 있는 경우\n    나. 실명이 아니거나 타인의 명의를 이용한 경우\n    다. 허위 정보를 기재하거나 필수 정보를 제공하지 않은 경우\n    라. 만 14세 미만인 경우 (단, 법정대리인의 동의가 있는 경우 예외)\n    마. 기타 이용계약의 체결이 회사의 기술상 또는 업무상 현저히 지장이 있는 경우\n\n4. 이용계약의 성립 시기는 회사가 가입완료를 신청절차 상에서 표시한 시점으로 합니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제8조 (미성년자 이용 제한) [신설] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="제8조 (미성년자 이용 제한)"
                    android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_badge_new"
                    android:textAppearance="@style/TextAppearance.QGuard.LabelSmall"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_badge_primary"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs"
                    android:layout_marginStart="@dimen/space_sm" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 만 14세 미만의 아동은 본 서비스에 가입할 수 없습니다.\n\n2. 만 14세 이상 만 19세 미만의 미성년자가 서비스에 가입하고자 하는 경우, 법정대리인의 동의를 받아야 합니다.\n\n3. 회사는 미성년자의 개인정보를 수집·이용하는 경우 개인정보보호법 제22조의2에 따라 법정대리인의 동의를 받습니다. 법정대리인의 동의 없이 미성년자의 개인정보를 수집·이용한 경우, 법정대리인은 그 동의를 철회할 수 있습니다."
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="@color/color_text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="@dimen/space_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_divider"
                android:layout_marginBottom="@dimen/space_xl" />

            <!-- 제9조 (회원정보의 변경) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="제9조 (회원정보의 변경)"
                android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
                android:textColor="@color/color_primary"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
