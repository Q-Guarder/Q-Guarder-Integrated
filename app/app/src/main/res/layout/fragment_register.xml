<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_xl">

        <!-- 브랜드 로고 영역 -->
        <LinearLayout
            android:id="@+id/ll_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_3xl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="Q-Guard"
                app:tint="@color/color_primary"
                android:layout_marginEnd="@dimen/space_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q-Guard"
                android:textAppearance="@style/TextAppearance.QGuard.TitleLarge"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textAppearance="@style/TextAppearance.QGuard.HeadlineLarge"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="@dimen/space_2xl"
            app:layout_constraintTop_toBottomOf="@id/ll_brand"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안전한 QR 스캔을 시작하세요"
            android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_sm"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 닉네임 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nickname"
            style="@style/Widget.QGuard.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="닉네임"
            android:layout_marginTop="@dimen/space_xl"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 이메일 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email"
            style="@style/Widget.QGuard.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="이메일"
            android:layout_marginTop="@dimen/space_base"
            app:layout_constraintTop_toBottomOf="@id/til_nickname"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 비밀번호 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            style="@style/Widget.QGuard.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="비밀번호 (8자 이상)"
            android:layout_marginTop="@dimen/space_base"
            app:endIconMode="password_toggle"
            app:endIconDrawable="@drawable/ic_password_visibility_toggle"
            app:helperTextEnabled="true"
            app:helperText="영문, 숫자를 포함한 8자 이상"
            app:layout_constraintTop_toBottomOf="@id/til_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 약관 동의 영역 (ISMS-P A.4.1.2 준수) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_agreement"
            style="@style/Widget.QGuard.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            app:layout_constraintTop_toBottomOf="@id/til_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_base">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="약관 동의 (필수)"
                    android:textAppearance="@style/TextAppearance.QGuard.TitleSmall"
                    android:textColor="@color/color_text_primary"
                    android:layout_marginBottom="@dimen/space_sm" />

                <!-- 이용약관 동의 행 -->
                <LinearLayout
                    android:id="@+id/row_terms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginBottom="@dimen/space_sm">

                    <CheckBox
                        android:id="@+id/cb_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:button="@drawable/selector_checkbox"
                        android:buttonTint="@null"
                        app:buttonTint="@null"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="(필수) 서비스 이용약관에 동의합니다"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_terms_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보기"
                        android:textAppearance="@style/TextAppearance.QGuard.LabelLarge"
                        android:textColor="@color/color_primary"
                        android:padding="@dimen/space_sm" />

                </LinearLayout>

                <!-- 개인정보처리방침 동의 행 -->
                <LinearLayout
                    android:id="@+id/row_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <CheckBox
                        android:id="@+id/cb_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:button="@drawable/selector_checkbox"
                        android:buttonTint="@null"
                        app:buttonTint="@null"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="(필수) 개인정보 처리방침에 동의합니다"
                        android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_privacy_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보기"
                        android:textAppearance="@style/TextAppearance.QGuard.LabelLarge"
                        android:textColor="@color/color_primary"
                        android:padding="@dimen/space_sm" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 가입 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            style="@style/Widget.QGuard.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_md"
            android:text="가입하기"
            android:textAppearance="@style/TextAppearance.QGuard.TitleMedium"
            android:layout_marginTop="@dimen/space_xl"
            android:enabled="false"
            app:layout_constraintTop_toBottomOf="@id/card_agreement"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 로딩 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_base"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 로그인으로 -->
        <TextView
            android:id="@+id/tv_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이미 계정이 있으신가요? 로그인"
            android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:padding="@dimen/space_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="@dimen/space_2xl" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>