<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/color_outline"
        android:alpha="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_base"
        android:paddingBottom="@dimen/space_2xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="히스토리 보관 기간"
            android:textAppearance="@style/TextAppearance.QGuard.HeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="@dimen/space_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="화면에 표시할 기간을 선택하세요. 서버 데이터는 유지됩니다."
            android:textAppearance="@style/TextAppearance.QGuard.BodySmall"
            android:textColor="@color/color_text_tertiary"
            android:layout_marginBottom="@dimen/space_xl" />

        <RadioGroup
            android:id="@+id/rg_retention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/space_xl">

            <RadioButton
                android:id="@+id/rb_all"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="전체 기록"
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_7days"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="최근 7일"
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/rb_30days"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="최근 30일"
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/rb_90days"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="최근 90일"
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/rb_180days"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="최근 180일"
                android:textAppearance="@style/TextAppearance.QGuard.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/Widget.QGuard.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_md"
            android:text="적용하기" />

    </LinearLayout>
</LinearLayout>
