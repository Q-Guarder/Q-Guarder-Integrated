# ============================================================
#  Q-Guarder Server — 환경 변수 템플릿
#  이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 채워주세요.
#  cp .env.example .env
# ============================================================


# ────────────────────────────────────────────────────────────
#  DATABASE — PostgreSQL (비동기 드라이버)
# ────────────────────────────────────────────────────────────

# 형식: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Docker Compose: db 컨테이너명을 호스트로 사용
DATABASE_URL=postgresql+asyncpg://postgres:localdev123@db:5432/qguarder


# ────────────────────────────────────────────────────────────
#  AUTH_SECURITY — JWT 인증 / 토큰 설정
# ────────────────────────────────────────────────────────────

# JWT 서명 시크릿 키 (최소 32자 이상 권장)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 쿠키 Secure 플래그 (HTTPS 전용 쿠키)
# 로컬 개발(HTTP)에서는 False, 프로덕션(HTTPS)에서는 True
COOKIE_SECURE=False


# ────────────────────────────────────────────────────────────
#  KISA_REPORT — 위험 URL 신고 메일 (SMTP)
# ────────────────────────────────────────────────────────────
# 앱에서 '위험' 판정 URL을 신고하면 아래 설정으로 메일을 보냅니다.
# 세 가지(ENABLED=True, RECIPIENT, SMTP 계정)가 모두 있어야 발송합니다.

# 발송 스위치 — False(기본)면 신고를 받아도 메일을 보내지 않음
KISA_REPORT_ENABLED=False

# 받는 주소 — 비어 있으면 보내지 않음
#   테스트: 본인 메일 주소
#   실제 신고: cert@kisa.or.kr  (가짜 신고가 나가지 않도록 테스트 때는 절대 넣지 말 것)
KISA_REPORT_RECIPIENT=

# 보내는 메일 계정 — Gmail 기준
#   1) 구글 계정 → 보안 → 2단계 인증 켜기
#   2) https://myaccount.google.com/apppasswords 에서 '앱 비밀번호'(16자리) 생성
#   3) SMTP_USERNAME=Gmail 주소, SMTP_PASSWORD=앱 비밀번호 (일반 비밀번호로는 로그인 안 됨)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
# 보내는 사람 표시 주소 (비우면 SMTP_USERNAME)
MAIL_FROM=


# ────────────────────────────────────────────────────────────
#  EXTERNAL_API — 외부 서비스 연동
# ────────────────────────────────────────────────────────────

# VirusTotal API 키
# 발급: https://www.virustotal.com/gui/my-apikey (무료: 분당 4회)
# 비워두면 VT 결과가 0/0으로 반환되고 ML 점수만 사용됨
VIRUSTOTAL_API_KEY=


# ────────────────────────────────────────────────────────────
#  APP_CONFIG — 애플리케이션 일반 설정
# ────────────────────────────────────────────────────────────

PROJECT_NAME=Q-Guarder
API_V1_PREFIX=/api/v1

# CORS 허용 출처 (쉼표 구분, 개발 시: *)
CORS_ORIGINS=*

# HTTPS 쿠키 (로컬: False, 운영: True)
COOKIE_SECURE=False
