# ============================================================
#  Q-Guarder Server — 환경 변수 템플릿
#  이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 채워주세요.
#  cp .env.example .env
# ============================================================


# ────────────────────────────────────────────────────────────
#  DATABASE — PostgreSQL (비동기 드라이버)
# ────────────────────────────────────────────────────────────

# 형식: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Docker Compose: db 컨테이너명을 호스트로 사용
DATABASE_URL=postgresql+asyncpg://postgres:localdev123@db:5432/qguarder


# ────────────────────────────────────────────────────────────
#  AUTH_SECURITY — JWT 인증 / 토큰 설정
# ────────────────────────────────────────────────────────────

# JWT 서명 시크릿 키 (최소 32자 이상 권장)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 쿠키 Secure 플래그 (HTTPS 전용 쿠키)
# 로컬 개발(HTTP)에서는 False, 프로덕션(HTTPS)에서는 True
COOKIE_SECURE=False


# ────────────────────────────────────────────────────────────
#  CLOUD_INFRA — AWS 리소스
# ────────────────────────────────────────────────────────────

AWS_REGION=ap-northeast-2

# S3 — ML 모델 저장 버킷
# 비워두면 local_models/final_with_fs_top17_e1_top17_xgb_lgbm_threshold041.pkl 자동 로드 (개발용)
# 운영 배포 시 실제 버킷명 입력
S3_MODEL_BUCKET=
S3_MODEL_KEY=models/final_with_fs_top17_e1_top17_xgb_lgbm_threshold041.pkl

# SES — KISA 제보 발신 이메일 (운영 배포 시 설정)
SES_SENDER_EMAIL=

# KISA(cert@kisa.or.kr) 자동 신고 메일 발송 스위치
# False(기본): BLOCKED URL 을 신고해도 메일을 보내지 않음 (로컬 개발·시연·테스트)
# True: 실제 메일 발송 — 운영 배포에서만 켤 것
KISA_REPORT_ENABLED=False


# ────────────────────────────────────────────────────────────
#  EXTERNAL_API — 외부 서비스 연동
# ────────────────────────────────────────────────────────────

# VirusTotal API 키
# 발급: https://www.virustotal.com/gui/my-apikey (무료: 분당 4회)
# 비워두면 VT 결과가 0/0으로 반환되고 ML 점수만 사용됨
VIRUSTOTAL_API_KEY=


# ────────────────────────────────────────────────────────────
#  APP_CONFIG — 애플리케이션 일반 설정
# ────────────────────────────────────────────────────────────

PROJECT_NAME=Q-Guarder
API_V1_PREFIX=/api/v1

# CORS 허용 출처 (쉼표 구분, 개발 시: *)
CORS_ORIGINS=*

# HTTPS 쿠키 (로컬: False, 운영: True)
COOKIE_SECURE=False
